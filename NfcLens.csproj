<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\nfc-lens.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Optional network logos: drop brand_visa.png and brand_mastercard.png into Assets\ to replace the text marks. -->
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Core/**/*.cs" />
    <ProjectReference Include="Core/NfcLens.Core.csproj" />
    <Compile Update="MainWindow.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainWindow.Designer.cs">
      <DependentUpon>MainWindow.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
